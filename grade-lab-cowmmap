#!/usr/bin/env python3

import re
from gradelib import *

r = Runner(save("xv6.out"))

@test(0, "running cowtest")
def test_cowtest():
    r.run_qemu(shell_script(["cowtest"]), timeout=300)

@test(8, "cowtest: simple", parent=test_cowtest)
def test_cow_simple():
    assert_equal(len(re.findall("^simple: ok$", r.qemu.output, re.M)), 2)

@test(8, "cowtest: three", parent=test_cowtest)
def test_cow_three():
    assert_equal(len(re.findall("^three: ok$", r.qemu.output, re.M)), 3)

@test(7, "cowtest: file", parent=test_cowtest)
def test_cow_file():
    r.match("^file: ok$")

@test(7, "cowtest: forkfork", parent=test_cowtest)
def test_cow_forkfork():
    r.match("^forkfork: ok$")

