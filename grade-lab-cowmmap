@test(0, "running integration tests")
def test_vmtest():
    r.run_qemu(shell_script(["vmtest"]), timeout=180)

@test(8, "vmtest: private mapping across fork", parent=test_vmtest)
def test_vm_private():
    r.match("^vmtest: private fork: OK$")

@test(7, "vmtest: resident shared mapping across fork", parent=test_vmtest)
def test_vm_shared():
